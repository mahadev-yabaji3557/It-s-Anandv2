# SmartRail Hygiene - Environment Configuration
# Copy this file to .env.local to link with a live Firebase Realtime Database project

# Firebase Web App Credentials
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# When left blank, SmartRail Hygiene runs seamlessly with its built-in
# Autonomous IoT Hardware Simulator with live MQ-135 and ultrasonic water drift.
